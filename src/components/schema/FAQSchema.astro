---
/**
 * FAQSchema.astro - FAQPage Schema.org structured data
 * Generates FAQPage schema for FAQ sections
 */

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQ[];
}

const { faqs } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<script
  set:html={JSON.stringify(schema)}
  type="application/ld+json"
/>
