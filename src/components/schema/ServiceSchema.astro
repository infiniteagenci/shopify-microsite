---
/**
 * ServiceSchema.astro - Service Schema.org structured data
 * Generates Service schema for services offered
 */

interface Props {
  name: string;
  description: string;
  provider?: {
    name: string;
    url?: string;
  };
  serviceType?: string;
  areaServed?: string[];
  hasOfferCatalog?: {
    name: string;
    itemListElement?: Array<{
      typeOf: string;
      name: string;
      description?: string;
    }>;
  };
  url?: string;
  image?: string;
}

const {
  name,
  description,
  provider,
  serviceType,
  areaServed,
  hasOfferCatalog,
  url,
  image,
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name,
  description,
  ...(provider && {
    provider: {
      "@type": "Organization",
      ...provider,
    },
  }),
  ...(serviceType && { serviceType }),
  ...(areaServed && {
    areaServed: areaServed.map((area) => ({
      "@type": "City",
      name: area,
    })),
  }),
  ...(hasOfferCatalog && {
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: hasOfferCatalog.name,
      ...(hasOfferCatalog.itemListElement && {
        itemListElement: hasOfferCatalog.itemListElement.map((item, index) => ({
          "@type": "Offer",
          position: index + 1,
          typeOf: item.typeOf,
          name: item.name,
          ...(item.description && { description: item.description }),
        })),
      }),
    },
  }),
  ...(url && { url }),
  ...(image && { image }),
};
---

<script
  set:html={JSON.stringify(schema)}
  type="application/ld+json"
/>
