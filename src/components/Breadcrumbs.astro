---
/**
 * Breadcrumbs JSON-LD schema (invisible structured data)
 * Generates BreadcrumbList schema from the current URL path.
 * The visible breadcrumb navigation has been removed from the UI.
 */
import { getBreadcrumbSchema } from '../utils/breadcrumbs.ts';

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

// Get current path and build breadcrumbs
const path = Astro.url.pathname;
const breadcrumbs = [
  { name: 'Home', url: '/' },
];

// Split path and build breadcrumb items
if (path !== '/') {
  const segments = path.split('/').filter(Boolean);
  let buildPath = '';

  for (let i = 0; i < segments.length; i++) {
    buildPath += '/' + segments[i];
    const isLast = i === segments.length - 1;

    // Format segment name (capitalize and replace hyphens)
    let name = segments[i]
      .split('-')
      .map(word => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');

    // Use custom page title if provided, otherwise use formatted name
    if (isLast && currentPage) {
      name = currentPage;
    }

    breadcrumbs.push({
      name,
      url: buildPath + (isLast ? '' : '/'),
    });
  }
}

// Generate JSON-LD schema
const schema = getBreadcrumbSchema(breadcrumbs);
---

<!-- BreadcrumbList JSON-LD Schema -->
<script
  set:html={JSON.stringify(schema)}
  type="application/ld+json"
/>