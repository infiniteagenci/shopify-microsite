---
export interface Props {
    href: string;
    text: string;
}
const { href, text } = Astro.props;
---

<li>
    <a
        href={href}
        class="duration-300 font-light ease-linear hover:text-primary py-3 relative group transition-all transform hover:scale-105"
    >
        {text}
        <span class="absolute bottom-0 left-0 w-full h-0.5 bg-primary transform scale-x-0 transition-transform duration-300 group-hover:scale-x-100"></span>
    </a>
</li>
