---
import "../../styles/global.css"
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/shared/Container.astro';
import Paragraph from '../../components/shared/Paragraph.astro';
import Button from '../../components/shared/Button.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getEntry('blog', slug);
const { Content } = await post.render();
const seoDescription = post.data.description;

// Get related posts (same category, excluding current post)
const allPosts = await getCollection('blog');
    const relatedPosts = allPosts
      .filter(p => p.data.category === post.data.category && p.slug !== post.slug)
      .slice(0, 3);

    // Sort all posts by date for prev/next navigation
    const sortedPosts = allPosts
      .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

    const currentIndex = sortedPosts.findIndex(p => p.slug === post.slug);
    const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
    const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

---

<Layout title={post.data.title} description={seoDescription}>
  <main class="flex flex-col gap-y-12 overflow-hidden">
    <!-- Hero Section with Image -->
    <section class="relative pt-16 lg:pt-20 pb-12">
      <div class="absolute inset-0">
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/80"></div>
      </div>

      <Container className="relative z-10">
        <!-- Back to Blog Link -->
        <div class="flex justify-center mb-6">
          <a href="/blog" class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm text-white rounded-full text-sm font-medium hover:bg-white/20 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Blog
          </a>
        </div>

        <div class="max-w-4xl mx-auto text-center text-white">
          <div class="flex justify-center mb-4">
            <span class="px-4 py-2 bg-primary/90 backdrop-blur-sm text-white rounded-full text-sm font-semibold">
              {post.data.category}
            </span>
          </div>

          <h1 class="text-4xl/tight sm:text-5xl/tight md:text-6xl/tight font-bold mb-4">
            {post.data.title}
          </h1>

          <div class="flex items-center justify-center gap-4 text-white/80">
            <time datetime={post.data.date}>
              {new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
            <span class="w-1 h-1 rounded-full bg-white/60"></span>
            <span>{post.data.readTime}</span>
          </div>
        </div>
      </Container>
    </section>

    <!-- Content -->
    <section class="py-8">
      <Container className="max-w-4xl mx-auto">
        <article class="max-w-none">
          <div class="bg-box-bg rounded-2xl p-8 md:p-10 shadow-lg border border-box-border blog-content">
            <Content />
          </div>
        </article>
      </Container>
    </section>

    <!-- Prev/Next Navigation -->
    <section class="py-8">
      <Container className="max-w-6xl mx-auto">
        <div class="grid sm:grid-cols-2 gap-6">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="group flex items-center gap-4 p-5 rounded-2xl bg-box-bg border border-box-border hover:border-primary/50 transition-all hover:shadow-lg">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-heading-3 mb-1">Previous Article</p>
                <h3 class="font-semibold text-heading-1 group-hover:text-primary transition-colors line-clamp-1">
                  {prevPost.data.title}
                </h3>
              </div>
            </a>
          ) : (
            <div></div>
          )}
          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="group flex items-center gap-4 p-5 rounded-2xl bg-box-bg border border-box-border hover:border-primary/50 transition-all hover:shadow-lg sm:flex-row-reverse">
              <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary group-hover:scale-110 transition-transform shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
              <div class="text-right sm:text-left">
                <p class="text-xs text-heading-3 mb-1">Next Article</p>
                <h3 class="font-semibold text-heading-1 group-hover:text-primary transition-colors line-clamp-1">
                  {nextPost.data.title}
                </h3>
              </div>
            </a>
          ) : (
            <div></div>
          )}
        </div>
      </Container>
    </section>



    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="py-12">
        <Container className="max-w-6xl mx-auto">
          <h2 class="text-2xl/tight sm:text-3xl/tight font-bold text-heading-1 text-center mb-8">
            Related Articles
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedPosts.map((relatedPost) => (
              <article class="group flex flex-col h-full rounded-2xl bg-box-bg border border-box-border overflow-hidden hover:border-primary/50 transition-all hover:shadow-xl">
                <a href={`/blog/${relatedPost.slug}`} class="block">
                  <div class="relative aspect-video overflow-hidden">
                    <img
                      src={relatedPost.data.image}
                      alt={relatedPost.data.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <span class="absolute top-3 left-3 px-3 py-1 text-xs font-semibold bg-primary/90 backdrop-blur-sm text-white rounded-full">
                      {relatedPost.data.category}
                    </span>
                  </div>

                  <div class="p-5 flex-1 flex flex-col">
                    <div class="flex items-center gap-3 text-sm text-heading-3 mb-2">
                      <time datetime={relatedPost.data.date}>
                        {new Date(relatedPost.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                      </time>
                      <span class="w-1 h-1 rounded-full bg-heading-3"></span>
                      <span>{relatedPost.data.readTime}</span>
                    </div>

                    <h3 class="text-lg/tight font-bold text-heading-1 mb-2 group-hover:text-primary transition-colors line-clamp-2">
                      {relatedPost.data.title}
                    </h3>

                    <p class="text-heading-3 mb-4 line-clamp-2 flex-1 text-sm">
                      {relatedPost.data.description}
                    </p>

                    <div class="flex items-center gap-2 text-primary font-semibold group-hover:gap-3 transition-all text-sm">
                      Read More
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </Container>
      </section>
    )}
  </main>
</Layout>

<style>
  .blog-content {
    color: rgb(var(--heading-2));
    line-height: 1.7;
    font-size: 1.125rem;
  }

  .blog-content h1,
  .blog-content h2,
  .blog-content h3,
  .blog-content h4,
  .blog-content h5,
  .blog-content h6 {
    color: rgb(var(--heading-1));
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 0.75em;
  }

  .blog-content h2 {
    font-size: 1.75rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .blog-content h3 {
    font-size: 1.375rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .blog-content p {
    margin-bottom: 1.5em;
    line-height: 1.8;
  }

  .blog-content p:last-child {
    margin-bottom: 0;
  }

  .blog-content ul,
  .blog-content ol {
    margin-bottom: 1.25em;
    padding-left: 1.5em;
  }

  .blog-content li {
    margin-bottom: 0.75em;
  }

  .blog-content strong,
  .blog-content b {
    color: rgb(var(--heading-1));
    font-weight: 600;
  }

  .blog-content a {
    color: rgb(230, 75, 0);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .blog-content a:hover {
    color: rgb(255, 75, 0);
  }

  .blog-content blockquote {
    border-left: 4px solid rgb(230, 75, 0);
    padding-left: 1.5em;
    margin: 2em 0;
    font-style: italic;
    background: rgba(230, 75, 0, 0.05);
    padding-top: 1em;
    padding-bottom: 1em;
    border-radius: 0.5rem;
  }

  .blog-content code {
    background: rgba(230, 75, 0, 0.1);
    color: rgb(230, 75, 0);
    padding: 0.25em 0.5em;
    border-radius: 0.25rem;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .blog-content em {
    color: rgb(var(--heading-3));
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
