---
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import Button from "../components/shared/Button.astro";
import Title from "../components/shared/Title.astro";

const seoDescription =
    "Get a comprehensive Shopify store audit covering growth opportunities, technical performance, and strategic roadmap. London-based experts with 25+ years eCommerce experience.";
---

<Layout
    title="Shopify Store Audit & Growth Strategy"
    description={seoDescription}
>
    <main class="flex flex-col">
        <!-- Hero Section -->
        <section class="relative pt-32 lg:pt-40 pb-20 overflow-hidden">
            <div
                class="absolute inset-0 bg-gradient-to-br from-orange-500/5 via-transparent to-purple-500/5"
            >
            </div>
            <Container className="relative z-10">
                <div class="max-w-4xl mx-auto text-center">
                    <span
                        class="inline-block px-4 py-2 rounded-full bg-red-100 text-red-600 text-sm font-semibold mb-6 animate-pulse"
                    >
                        Limited Time Offer
                    </span>
                    <h1
                        class="text-4xl/tight sm:text-5xl/tight md:text-6xl/tight font-bold text-heading-1 mb-6"
                    >
                        Unlock Your Shopify Store's <span
                            class="text-gradient-brand">Full Potential</span
                        >
                    </h1>
                    <Paragraph className="text-xl max-w-3xl mx-auto mb-10">
                        Get a detailed growth and technical audit of your store,
                        identify revenue opportunities, and receive a custom
                        strategy roadmap—all in one comprehensive report.
                    </Paragraph>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <a
                            href="#book-audit"
                            class="btn-primary glow-button inline-flex justify-center items-center px-8 py-4 text-black"
                        >
                            Book Your Audit
                        </a>
                        <a
                            href="#whats-included"
                            class="btn-secondary inline-flex justify-center items-center px-8 py-4"
                        >
                            What's Included
                        </a>
                    </div>
                    <p class="text-sm text-heading-3 mt-6">
                        No obligation. Detailed report delivered within 5
                        business days.
                    </p>
                </div>
            </Container>
        </section>

        <!-- What's Included -->
        <section id="whats-included" class="relative py-20">
            <Container className="max-w-6xl mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <Title>What's Included in Your Audit</Title>
                    <Paragraph>
                        A thorough analysis of your entire Shopify store
                        covering growth opportunities, technical health, and
                        strategic recommendations.
                    </Paragraph>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Technical Health -->
                    <div class="box card-hover">
                        <div
                            class="w-12 h-12 rounded-xl bg-orange-100 flex items-center justify-center text-primary mb-4"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="w-6 h-6"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-heading-1 mb-3">
                            Technical Health
                        </h3>
