---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/shared/Container.astro';
import Paragraph from '../../components/shared/Paragraph.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQSchema from '../../components/schema/FAQSchema.astro';
import SoftwareApplicationSchema from '../../components/schema/SoftwareApplicationSchema.astro';

const CTA_URL = 'https://xsquads.ai/shopify';

const seoDescription =
  'xSquads for Shopify: manage inventory, orders, pages, SEO/AEO audits and customer support by chatting with an AI agent in Slack. Isolated per store, built by Infinite.agency.';

const capabilities = [
  {
    title: 'Inventory & Stock Updates',
    description: 'Update inventory levels and out-of-stock information in plain English. Ask "mark the Alder chair as out of stock" and it is done — no clicking through the admin.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon-xl">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
    </svg>`,
  },
  {
    title: 'Order Status & Lookup',
    description: 'Check the status of any order, or find every order placed by a customer’s email. Answers come straight from your store’s Admin API — live data, not guesses.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon-xl">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.113 0a48.424 48.424 0 00-1.123.08M9.75 8.936c-.83 0-1.5-.006-2.058-.02m10.558 0c.525.013 1.014.046 1.443.09M4.25 12.75a48.016 48.016 0 016.5-1.5m-6.5 5.25a48.016 48.016 0 016.5-1.5m12.75 6.75-3.75-3.75M18 10.5h.008v.008H18V10.5z" />
    </svg>`,
  },
  {
    title: 'Landing Page Creation',
    description: 'Create and manage pages on your store from the chat. Spin up a campaign landing page while you are still discussing the offer in Slack.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon-xl">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
    </svg>`,
  },
  {
    title: 'SEO Audits',
    description: 'Run a technical SEO audit of your storefront on demand, get the findings in-channel, and fix what matters — titles, meta data, structure and content.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon-xl">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
    </svg>`,
  },
  {
    title: 'AEO — AI Search Visibility',
    description: 'Audit how well your store speaks to AI answer engines like ChatGPT and Perplexity, and get actionable updates so your products show up in AI recommendations.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon-xl">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
    </svg>`,
  },
  {
    title: 'Customer Support Drafts',
    description: 'Connect your support mailbox and xSquads researches each ticket against real order data, then leaves a ready-to-send draft. Complicated cases are escalated to you — it never sends on its own.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="icon-xl">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
    </svg>`,
  },
];

const steps = [
  {
    title: 'Install the Shopify app',
    description: 'Add xSquads to your store from the Shopify App Store. A guided onboarding wizard connects your store securely — OAuth or your own Admin API key, both encrypted at rest.',
  },
  {
    title: 'Add the Slack app',
    description: 'Invite the xSquads app to your Slack workspace and pick a channel. This is where your store team and your AI agent will work together.',
  },
  {
    title: 'Chat with your store',
    description: 'Mention @xSquad and ask for anything: "what happened with order #1042?", "run an SEO audit", "create a landing page for the summer sale". Your agent gets it done.',
  },
];

const trustPoints = [
  {
    title: 'Isolated Per Store',
    description: 'Every store gets its own dedicated, sandboxed agent instance. Your data, chat history and credentials are never shared or mixed with another merchant’s.',
  },
  {
    title: 'Encrypted Credentials',
    description: 'Shopify and Google tokens are encrypted with AES-GCM and decrypted only at the moment of use. Secrets never reach the AI model or the logs.',
  },
  {
    title: 'Human In The Loop',
    description: 'Customer support replies are left as drafts — xSquads never sends to your customers on its own. Everything else is written to an audit log you can review.',
  },
  {
    title: 'Spend Caps Built In',
    description: 'A daily agent spend cap per store means your AI costs are predictable and bounded — no surprise bills at the end of the month.',
  },
];

const faqs = [
  {
    question: 'What is xSquads for Shopify?',
    answer: 'xSquads is a Shopify app that gives your store a dedicated AI agent living in Slack. Instead of clicking through the Shopify admin, you chat with @xSquad in plain English to update inventory, check orders, create landing pages, run SEO and AEO audits, and draft customer support replies. It was built by Infinite.agency, a London-based Shopify agency.'
  },
  {
    question: 'How do I install xSquads?',
    answer: 'Two installs, a few minutes total. First, add the xSquads app to your Shopify store and follow the onboarding wizard to connect your store credentials. Second, add the xSquads Slack app to your workspace. Once both are connected, you mention @xSquad in any channel and start managing your store by chat.'
  },
  {
    question: 'Is my store data safe with xSquads?',
    answer: 'Yes. Every store runs its own isolated, sandboxed agent instance — your data and chat history are never mixed with other merchants. Credentials are AES-GCM encrypted and only decrypted at the moment of use, secrets never enter the AI model or logs, and all agent writes are recorded in an audit ledger you can review.'
  },
  {
    question: 'Can xSquads reply to my customer support emails?',
    answer: 'It drafts the replies; you stay in control. Connect your Google or Gmail support mailbox, and the agent researches each incoming ticket against real order data — order status, refunds, shipping — then leaves a ready-to-send draft with its reasoning attached. Complicated or serious tickets are escalated straight to you. It never sends an email on its own.'
  },
  {
    question: 'What is an AEO audit?',
    answer: 'AEO stands for Answer Engine Optimization — making your store discoverable by AI answer engines like ChatGPT, Perplexity and Copilot, not just traditional search engines. xSquads runs an AEO audit of your storefront and gives you concrete updates, so your products are the ones AI assistants recommend when shoppers ask.'
  },
  {
    question: 'Do I need to know how to use Slack?',
    answer: 'Only the basics. If you can send a message, you can run your store with xSquads. Many merchants pick a single team channel where the whole store team can see what the agent is doing, ask questions and keep a shared, searchable history of every change.'
  }
];
---

<Layout title="xSquads for Shopify — Manage Your Store by Chat in Slack" description={seoDescription}>
    <FAQSchema faqs={faqs} />

    <SoftwareApplicationSchema
        name="xSquads for Shopify"
        description="xSquads gives Shopify stores a dedicated AI agent in Slack. Update inventory, check orders, create landing pages, run SEO and AEO audits, and draft customer support replies by chatting with @xSquad."
        applicationCategory="BusinessApplication"
        operatingSystem="Shopify"
        url={`${Astro.site}apps/xsquads`}
        image={`${Astro.site}images/og-image.jpg`}
        author={{ name: "Infinite.agency" }}
        publisher={{ name: "Infinite.agency" }}
        featureList={[
            'Inventory & stock updates by chat',
            'Order status & customer order lookup',
            'Landing page creation & page management',
            'Technical SEO audits',
            'AEO audits for AI answer engines',
            'Customer support email drafting with escalation'
        ]}
    />

    <main class="flex flex-col section-gap-y overflow-hidden">
        <Breadcrumbs currentPage="xSquads for Shopify" />

        <!-- Hero Section -->
        <section class="relative hero-padding-top hero-padding-bottom">
            <Container className="flex flex-col items-center text-center max-w-4xl mx-auto">
                <span class="badge mb-6 inline-block">AI Agent for Shopify × Slack</span>
                <h1 class="text-hero font-bold text-heading-1 mb-8">
                    Run Your Store by <span class="text-gradient-purple">Chatting in Slack</span>
                </h1>
                <Paragraph className="text-xl max-w-3xl">
                    xSquads gives your Shopify store a dedicated AI agent that lives in your Slack. Update inventory, check orders, publish landing pages, run SEO &amp; AEO audits and draft support replies — just mention @xSquad and ask.
                </Paragraph>
                <div class="flex flex-wrap justify-center gap-4 mt-10">
                    <a
                        href={CTA_URL}
                        class="btn-primary glow-button inline-flex justify-center items-center px-8 py-4 text-black"
                    >
                        Get Started with xSquads
                    </a>
                    <a
                        href="#capabilities"
                        class="btn-secondary inline-flex justify-center items-center px-8 py-4"
                    >
                        See What It Can Do
                    </a>
                </div>
            </Container>
        </section>

        <!-- How It Works -->
        <section class="relative section-padding-y">
            <Container className="max-w-5xl mx-auto">
                <h2 class="text-section-title font-bold text-heading-1 mb-6 text-center">
                    Up and Running in Minutes
                </h2>
                <Paragraph className="text-lg mb-12 text-center max-w-3xl mx-auto">
                    Two installs, zero code. Your agent is connected to your store's Admin API and ready to take requests.
                </Paragraph>
                <div class="grid md:grid-cols-3 gap-8">
                    {steps.map((step, index) => (
                        <div class="box p-8 text-center">
                            <div class="w-12 h-12 mx-auto mb-6 rounded-full flex items-center justify-center text-primary font-bold text-xl" style="background-color: rgb(var(--color-primary) / 0.1)">
                                {index + 1}
                            </div>
                            <h3 class="font-semibold text-heading-1 mb-3">{step.title}</h3>
                            <p class="text-sm text-heading-3 leading-relaxed">{step.description}</p>
                        </div>
                    ))}
                </div>
            </Container>
        </section>

        <!-- Capabilities -->
        <section id="capabilities" class="relative section-padding-y scroll-mt-32">
            <Container className="max-w-5xl mx-auto">
                <h2 class="text-section-title font-bold text-heading-1 mb-6 text-center">
                    What Your Agent Can Do
                </h2>
                <Paragraph className="text-lg mb-12 text-center max-w-3xl mx-auto">
                    Every request is executed against your store's live Admin API — real inventory, real orders, real pages.
                </Paragraph>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {capabilities.map((capability) => (
                        <div class="box p-8">
                            <div class="w-12 h-12 mb-6 rounded-xl flex items-center justify-center text-primary" style="background-color: rgb(var(--color-primary) / 0.1)">
                                <div set:html={capability.icon} />
                            </div>
                            <h3 class="font-semibold text-heading-1 mb-3">{capability.title}</h3>
                            <p class="text-sm text-heading-3 leading-relaxed">{capability.description}</p>
                        </div>
                    ))}
                </div>
            </Container>
        </section>

        <!-- Slack Example -->
        <section class="relative section-padding-y" style="background-color: rgb(var(--color-primary) / 0.05)">
            <Container className="max-w-3xl mx-auto">
                <h2 class="text-section-title font-bold text-heading-1 mb-12 text-center">
                    It Feels Like Messaging a Teammate
                </h2>
                <div class="box p-6 md:p-8 space-y-4">
                    <div class="flex gap-4 items-start">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0" style="background-color: rgb(var(--color-primary))">Y</div>
                        <div>
                            <p class="text-sm font-semibold text-heading-1">You</p>
                            <p class="text-heading-3">@xSquad mark the Alder chair as out of stock and check order #1042</p>
                        </div>
                    </div>
                    <div class="flex gap-4 items-start">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-bold shrink-0 text-gradient-purple">xS</div>
                        <div>
                            <p class="text-sm font-semibold text-heading-1">xSquad <span class="badge ml-2 text-xs">APP</span></p>
                            <p class="text-heading-3">Done — Alder Chair is now out of stock. Order #1042 was placed yesterday and is currently <strong>in fulfilment</strong>: tracking hasn't been added yet. Want me to check again later?</p>
                        </div>
                    </div>
                </div>
                <Paragraph className="text-sm text-heading-3 text-center mt-6">
                    Every answer is grounded in your store's live data — the agent queries the Shopify Admin API, never guesses.
                </Paragraph>
            </Container>
        </section>

        <!-- Trust & Architecture -->
        <section class="relative section-padding-y">
            <Container className="max-w-5xl mx-auto">
                <h2 class="text-section-title font-bold text-heading-1 mb-6 text-center">
                    Built for Trust, Not Just Talk
                </h2>
                <Paragraph className="text-lg mb-12 text-center max-w-3xl mx-auto">
                    xSquads runs on dedicated, sandboxed agent infrastructure with security designed in from day one.
                </Paragraph>
                <div class="grid md:grid-cols-2 gap-8">
                    {trustPoints.map((point) => (
                        <div class="box p-8 flex gap-6 items-start">
                            <svg class="icon-check shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <div>
                                <h3 class="font-semibold text-heading-1 mb-2">{point.title}</h3>
                                <p class="text-sm text-heading-3 leading-relaxed">{point.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </Container>
        </section>

        <!-- FAQ -->
        <section class="relative section-padding-y" style="background-color: rgb(var(--color-primary) / 0.05)">
            <Container className="max-w-3xl mx-auto">
                <h2 class="text-section-title font-bold text-heading-1 mb-12 text-center">
                    Frequently Asked Questions
                </h2>
                <div class="space-y-4">
                    {faqs.map((faq) => (
                        <details class="box p-6">
                            <summary class="font-semibold text-heading-1 cursor-pointer">{faq.question}</summary>
                            <p class="text-heading-3 text-sm leading-relaxed mt-4">{faq.answer}</p>
                        </details>
                    ))}
                </div>
            </Container>
        </section>

        <!-- CTA Section -->
        <section class="relative section-padding-y">
            <Container className="max-w-4xl mx-auto text-center">
                <div class="cta-box">
                    <h2 class="text-section-title font-bold text-heading-1 mb-6">
                        Give Your Store an AI Teammate
                    </h2>
                    <Paragraph className="text-lg mb-8">
                        Install xSquads, add it to Slack, and start running your store by chat today. Setup takes minutes — the onboarding wizard walks you through every step.
                    </Paragraph>
                    <div class="flex flex-wrap justify-center gap-4">
                        <a
                            href={CTA_URL}
                            class="btn-primary glow-button inline-flex justify-center items-center px-8 py-4 text-black"
                        >
                            Get Started with xSquads
                        </a>
                    </div>
                </div>
            </Container>
        </section>
    </main>
</Layout>